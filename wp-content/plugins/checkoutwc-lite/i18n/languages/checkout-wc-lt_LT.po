#: client/ts/admin/Components/CheckoutEditor/panels/EditorSettingsPanel.tsx:880
msgid "Billing Address Fields"
msgstr "Sąskaitos adreso laukai"

# // Kept as one string so translators see the whole sentence; <button> is the link into the modal.
#: client/ts/admin/Components/CheckoutEditor/panels/EditorSettingsPanel.tsx:883
